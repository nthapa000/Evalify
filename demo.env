# demo.env — demo users for Evalify (fake credentials, for testing the UI only).
# There is no admin UI for users yet: edit this file and restart the backend to add teachers, TAs or students.
#
# TEACHER_<n>=<email>|<password>|<name>|<subject>
# TA_<n>=<email>|<password>|<name>|<subject>[;<subject>…]       (same email on two lines = one TA, both subjects)
# STUDENT_<n>=<roll no>|<password>|<name>|<subject>[;<subject>…]
# STUDENTS_<n>=<subject>|<roll prefix>|<count>|<password>        (generates <prefix>001, <prefix>002, …)

# ── Teachers (one subject each) ──────────────────────────────────────────────
TEACHER_1=teacher@evalify.local|Teacher@123|Prof. Ramesh Kumar|Computer Science
TEACHER_2=physics.teacher@evalify.local|Teacher@123|Dr. Meera Iyer|Physics
TEACHER_3=maths.teacher@evalify.local|Teacher@123|Prof. Sunil Rao|Mathematics
TEACHER_4=ds.teacher@evalify.local|Teacher@123|Dr. Farah Siddiqui|Data Science

# ── TAs (per subject) ────────────────────────────────────────────────────────
TA_1=ta.cs1@evalify.local|Ta@12345|Rahul Menon|Computer Science
TA_2=ta.cs2@evalify.local|Ta@12345|Divya Shetty|Computer Science
TA_3=ta.physics@evalify.local|Ta@12345|Sana Khan|Physics
TA_4=ta.maths@evalify.local|Ta@12345|Amit Joshi|Mathematics
TA_5=ta.ds1@evalify.local|Ta@12345|Neha Kulkarni|Data Science
TA_6=ta.ds2@evalify.local|Ta@12345|Arvind Pillai|Data Science
# One TA helping in two subjects
TA_7=ta.science@evalify.local|Ta@12345|Kiran Das|Physics;Mathematics

# ── Students (10–50 per subject) ─────────────────────────────────────────────
STUDENTS_1=Computer Science|CS2025|30|Student@123
STUDENTS_2=Physics|PH2025|20|Student@123
STUDENTS_3=Mathematics|MA2025|15|Student@123
# Data Science: 49 here + CS2025002 below = 50 students (matches the 50 Mendeley answer sheets)
STUDENTS_4=Data Science|DS2025|49|Student@123
# Students enrolled in more than one subject
STUDENT_1=CS2025001|Student@123|Aarav Sharma|Computer Science;Mathematics
STUDENT_2=CS2025002|Student@123|Priya Patel|Computer Science;Physics;Data Science
