# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
venv/
.venv/
env/
.env/

evaluation_folder 

# ── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment / Secrets ────────────────────────────────────────────────────
*.env
# keep example files, the demo user list (fake credentials) and test fixtures in git
!*.env.example
!demo.env
!backend/tests/fixtures/*.env
.env.*
!.env.example

# ── Docker ───────────────────────────────────────────────────────────────────
# (.dockerignore files are committed — they keep venv/uploads out of images)

# ── ML / Model Weights ───────────────────────────────────────────────────────
*.gguf
*.bin
*.safetensors
# NB: was `models/`, which also ignored backend/app/models (Pydantic schemas)
/models/
*.pt
*.pth
*.onnx

# ── DVC (data version control) ───────────────────────────────────────────────
# DVC tracks data/model files; only commit .dvc pointer files
/data/
/models/
.dvc/tmp/
.dvc/cache/

# ── MLflow ───────────────────────────────────────────────────────────────────
mlruns/
mlflow/mlruns/

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Test / Coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Evalify eval runs / cluster ──────────────────────────────────────────────
eval/runs/
eval/data/*/images/
!eval/data/example/images/
slurm-*.out

eval/reports/*/crops/

# Copies of the own-dataset photos and papers made by backend/app/db/demo_data.py
backend/uploads/demo/
backend/uploads/papers/demo_*
